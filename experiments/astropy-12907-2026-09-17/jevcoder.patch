     assert not model_c().separable
     assert np.all(separability_matrix(model_c()) == [True, True])
+
+
+@pytest.mark.parametrize('grouping', [
+    lambda a, b, c: (a & b) & c,
+    lambda a, b, c: a & (b & c),
+    lambda a, b, c: a & ((b & c) & (b & c)),
+])
+def test_nested_compound_separability(grouping):
+    model = grouping(models.Pix2Sky_TAN(), models.Linear1D(10),
+                     models.Linear1D(5))
+    expected = np.eye(model.n_inputs, dtype=bool)
+    expected[:2, :2] = True
+    assert_allclose(separability_matrix(model), expected)
+    assert_allclose(is_separable(model), [False, False] +
+                    [True] * (model.n_outputs - 2))
+
+
+def test_cstack_array_preserves_dependencies():
+    # A non-square right-hand matrix must retain zeros and dependency counts.
+    right = np.array([[0, 2], [1, 0], [0, 1]])
+    result = _cstack(sh1, right)
+    assert_allclose(result, [[1, 0, 0],
+                             [0, 0, 2],
+                             [0, 1, 0],
+                             [0, 0, 1]])
